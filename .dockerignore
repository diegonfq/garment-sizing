# --- Docker ---
# Ignore the Dockerfile itself and the .dockerignore file
Dockerfile
.dockerignore

# --- Git ---
# Ignore the entire Git history and configuration
.git/
.gitignore

# --- Python Virtual Environment ---
# This is the most important one to ignore. The container will have its own
# isolated environment with dependencies installed via pyproject.toml.
.venv/
venv/
env/

# --- Python Cache & Compiled Files ---
# These are generated by the interpreter and are not needed in the image.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- IDE and Editor Directories ---
# Ignore project-specific settings for PyCharm and VSCode
.idea/
.vscode/

# --- Local Data and Configuration ---
# The container should generate its own database, not use your local one.
# The .env file might contain local secrets that should not be in the image.
data/
.env

# --- Testing and Examples ---
# The test suite and example scripts are not needed for the final application to run.
tests/
examples/
pytest.ini
.pytest_cache/

# --- Development Tooling ---
# Configuration for tools that are not needed inside the container.
.pre-commit-config.yaml

# --- Documentation ---
# Documentation files are not needed for the application to run.
README.md
